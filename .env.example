# Copy this file to .env and adjust if needed:  cp .env.example .env

# Where Ollama is running. Inside Docker use host.docker.internal;
# in dev mode (uvicorn on your laptop) use http://localhost:11434
OLLAMA_URL=http://host.docker.internal:11434
LLM_MODEL=llama3.1:8b
LLM_NUM_CTX=8192
LLM_TIMEOUT=180

# Qdrant: http://qdrant:6333 inside Docker Compose, http://localhost:6333 in dev mode
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=nexus_chunks

EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

DATA_DIR=./data
MAX_UPLOAD_MB=25
